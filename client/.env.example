# Local environment - copy to .env and fill in.
# NEVER commit real values.
# Allowed example files (checked in):
#   client/.env.example
#   web/.env.example
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# For the first pass, the client points at the same LiveKit server the agent runs on.
AGENT_ROOM_NAME=personal-ai-agent-room
# Flask web layer
FLASK_PORT=5000
FLASK_DEBUG=0
