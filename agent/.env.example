# Jarvis agent environment. Copy to .env and fill in. Never commit .env.
# No secrets in code — everything sensitive comes from here.

# Nat (n8n) tool bridge: Gmail + Calendar go through this webhook.
JARVIS_NAT_WEBHOOK=http://localhost:5678/webhook/jarvis-tools
JARVIS_WEBHOOK_SECRET=change-me-to-a-long-random-secret

# Local LLM for the voice pipeline (Ollama, OpenAI-compatible).
OLLAMA_URL=http://localhost:11434/v1

# SQLite file for notes, reminders, memory, confirmations.
# Defaults to ~/.jarvis/jarvis.db when unset.
JARVIS_DB=

# LiveKit server (self-hosted or Cloud) the agent worker dials into.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Flask companion web layer.
FLASK_PORT=5000
