# Personal AI Agent - deployment environment.
#
# This is an EXAMPLE only - never commit real values.
# deploy.sh copies this to /opt/jarvis/.env (mode 600) on first run and
# generates JARVIS_WEBHOOK_SECRET + the LiveKit key pair automatically.

# --- Flask web layer ---------------------------------------------------------
FLASK_PORT=5000
FLASK_DEBUG=0

# --- Local Ollama (already on the VPS, :11434) -------------------------------
OLLAMA_URL=http://localhost:11434

# --- LiveKit server (self-hosted docker, see deploy/docker-compose.livekit.yml)
# Internal URL for the agent worker; public wss:// URL for clients/token minting.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=wss://livekit.86-48-18-41.sslip.io
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Data --------------------------------------------------------------------
JARVIS_DATA_DIR=/opt/jarvis/data
JARVIS_DB=/opt/jarvis/data/jarvis.db

# --- Integration hooks (Zapier etc.) -----------------------------------------
# Shared secret the Flask layer checks on incoming webhooks. Generated by deploy.sh.
JARVIS_WEBHOOK_SECRET=
